# Security headers applied by Cloudflare Pages to every response.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' https://static.cloudflareinsights.com; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://cloudflareinsights.com; form-action 'self' https://app.kit.com; frame-ancestors 'none'; base-uri 'self'; object-src 'none'; upgrade-insecure-requests
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=()
  Cross-Origin-Opener-Policy: same-origin

/fonts/*
  Cache-Control: public, max-age=31536000, immutable
  # Charts run in a sandboxed (opaque-origin) frame, so loading the site fonts is a cross-origin request.
  Access-Control-Allow-Origin: *

# Interactive charts (layouts/_partials/chart-embed.html). Each chart file carries its own
# Content-Security-Policy in a <meta> tag: inline scripts and styles only, nothing from other
# sites. The site-wide policy and frame blocking are removed here so articles can frame them,
# and the article's iframe sandbox keeps the chart's scripts away from the site.
/embeds/*
  ! Content-Security-Policy
  ! X-Frame-Options
  X-Robots-Tag: noindex
/css/*
  Cache-Control: public, max-age=31536000, immutable
